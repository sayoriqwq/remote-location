# Optional overrides for the repository-local commands.
# Copy this file to .env.local; that file is ignored by Git.

# Usually unnecessary: a single paired physical iPhone is discovered automatically.
REMOTE_LOCATION_DEVICE="Your iPhone name or private identifier"

# rl-start defaults to one hour. Valid range: 60 through 86400 seconds.
REMOTE_LOCATION_SECONDS=3600

# Usually unnecessary: rl-install auto-selects when exactly one valid code-signing
# identity exists. Keep any override only in the Git-ignored .env.local.
# REMOTE_LOCATION_CODE_SIGN_IDENTITY="40-character certificate fingerprint"
